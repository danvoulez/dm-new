# UI → Workers API (permanent hybrid). In dev vite proxies /api to this; in Pages set the same.
VITE_API_URL=
# Local dev: LAB_API_URL=http://127.0.0.1:8787 npm run dev  (bench SQLite)
# Prod:      VITE_API_URL=https://api.carbonlab.work  # via Workers custom domain
# Fallback: VITE_API_URL=https://dm-lab-api.dan-1f4.workers.dev
# Dev mirror prod without touching prod: LAB_API_URL=https://api.carbonlab.work npm --prefix ui run dev
