# Permanent ledger — Postgres is authoritative. LAB_DB is bench-only; prod uses SUPABASE/DATABASE_URL via Hyperdrive.
LAB_DB=.lab/lab.sqlite
LAB_MODE=bench

# Permanent (Workers → Postgres via Hyperdrive)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=<service_role>  # never in git, wrangler secret put
# DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# LAB_MODE=production

# UI → API
# VITE_API_URL=https://dm-lab-api.<you>.workers.dev
