{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "process_ingress.v1",
  "description": "Uma ou mais intenções formalizadas. Registro puro omite processo; consequência cita o contrato consultado.",
  "type": "object",
  "required": ["acts"],
  "additionalProperties": false,
  "properties": {
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slots", "fields", "missing", "citations"],
        "additionalProperties": false,
        "properties": {
          "process_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*\\.v[0-9]+$"
          },
          "contract_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "slots": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "description": "Somente slots cuja fonte declarada é llm."
          },
          "fields": {
            "type": "object",
            "description": "AUX declarados pelo contrato; em registro puro, metadados do fato."
          },
          "missing": {
            "type": "array",
            "items": {"type": "string"}
          },
          "citations": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "allOf": [
          {
            "if": {"required": ["process_id"]},
            "then": {"required": ["contract_hash"]},
            "else": {"not": {"required": ["contract_hash"]}}
          }
        ]
      }
    },
    "note": {
      "type": "string",
      "maxLength": 280
    }
  }
}
